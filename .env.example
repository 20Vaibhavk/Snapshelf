# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real keys and never paste them into chats.

# Cloudinary: Console > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gemini API: https://aistudio.google.com > Get API key
GEMINI_API_KEY=your_gemini_api_key

# Gemma 4 model ID exactly as shown in Google AI Studio's model list
GEMMA_MODEL=gemma-4-27b-it

# Optional
MAX_UPLOAD_MB=10
DEMO_MODE=false
